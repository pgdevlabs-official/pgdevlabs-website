# Copy this file to .env.local and fill in your real Firebase config values.
# Get these from: Firebase Console > kharchamate-cce0d > Project Settings >
# General tab > scroll to "Your apps" > Web app > SDK setup and configuration.
#
# If you don't have a Web app registered yet under kharchamate-cce0d:
# Project Settings > General > "Add app" > choose the Web (</>) icon >
# register with nickname "PGDevLabs" > it will show you these values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kharchamate-cce0d.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kharchamate-cce0d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kharchamate-cce0d.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Exact Firebase Auth email allowed to open the admin dashboard (no password).
NEXT_PUBLIC_ADMIN_EMAIL=

# UPI ID shown in buyer payment QR codes.
NEXT_PUBLIC_MARKETPLACE_UPI_ID=9798770034@naviaxis
